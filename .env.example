# ==============================================================================
# POLYMERHUB OF INDIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: https://polymerhubofindia.com
# Copy this file to .env.local and fill in the production / development keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service-Role Admin Key (CRITICAL SECRET: Never expose to browser)
# Used for server-side admin APIs, elevated triggers, and webhook verification.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (₹149/mo & ₹1,429/yr Plans)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Public: Used by Checkout SDK on frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# Razorpay Key ID (Server-side API order creation)
RAZORPAY_KEY_ID=rzp_live_...

# Razorpay Secret (Server-side HMAC-SHA256 signature verification)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Validates webhook payloads from Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 3. AI Copilot & Generation Engines
# ------------------------------------------------------------------------------
# Google Gemini API Key (Gemini 2.0 Flash / Pro models for AI Tutor & Generators)
GEMINI_API_KEY=AIzaSy...

# OpenRouter API Key (Optional fallback model router)
OPENROUTER_API_KEY=sk-or-...

# ------------------------------------------------------------------------------
# 4. Email Delivery Gateway (Resend)
# ------------------------------------------------------------------------------
# Resend API Key for sending in-app contact submissions and notifications
RESEND_API_KEY=re_...

# Verified sending email address configured on your DNS (e.g., Zoho / Resend)
RESEND_FROM_EMAIL="PolymerHub <hello@polymerhubofindia.com>"

# ------------------------------------------------------------------------------
# 5. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate using `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...

# ------------------------------------------------------------------------------
# 6. Operational, Maintenance & Security Flags
# ------------------------------------------------------------------------------
# Bearer secret for automated background cron jobs (e.g., /api/cron/video-health)
CRON_SECRET=your_long_random_cron_token_here

# Enable payment simulator for development sandbox (STRICTLY 'false' in production)
ALLOW_PAYMENT_SIMULATE=false

# Node runtime environment
NODE_ENV=development
